# StockSense AI Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Market Data & News Providers
MARKET_DATA_API_KEY=
NEWS_API_KEY=
ENABLE_LIVE_DATA=false

# Payment Gateway Providers (Stripe & Razorpay)
# Keep all secret keys server-side only. Never expose to client bundles.
DEFAULT_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
